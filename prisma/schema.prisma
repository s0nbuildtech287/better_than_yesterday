generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Habit {
  id                String            @id @default(cuid())
  title             String
  description       String?
  category          String            // HYGIENE_MORNING, HYGIENE_NIGHT, FITNESS, LEARNING, MEAL_PREP, CUSTOM
  icon              String            @default("Sparkles")
  timeOfDay         String            @default("ANYTIME") // MORNING, EVENING, ANYTIME
  targetDaysPerWeek Int               @default(7)
  startDate         String?           // YYYY-MM-DD Start Date of the habit
  rewardAmount      Int               @default(1000) // Value saved/earned in VNĐ (e.g. 35000 for cooking, 10000 for no soft drink)
  isActive          Boolean           @default(true)
  createdAt         DateTime          @default(now())
  updatedAt         DateTime          @updatedAt
  completions       HabitCompletion[]
}

model HabitCompletion {
  id          String   @id @default(cuid())
  habitId     String
  habit       Habit    @relation(fields: [habitId], references: [id], onDelete: Cascade)
  logDate     String   // YYYY-MM-DD
  completed   Boolean  @default(true)
  note        String?  // Ghi chú riêng cho thói quen ngày đó (vd: "Chạy 5km", "Đá bóng")
  completedAt DateTime @default(now())

  @@unique([habitId, logDate])
}

model DailyLog {
  id            String   @id @default(cuid())
  logDate       String   @unique // YYYY-MM-DD
  mood          String?  // GREAT, GOOD, OKAY, TIRED
  notes         String?
  proofImageUrl String?
  streakCount   Int      @default(0)
  effortScore   Int      @default(0) // 0-100%
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model MotivationalQuote {
  id        String   @id @default(cuid())
  quote     String
  author    String   @default("Kỷ Luật Bản Thân")
  category  String   @default("GENERAL")
  createdAt DateTime @default(now())
}

model TodoItem {
  id        String   @id @default(cuid())
  title     String
  completed Boolean  @default(false)
  priority  String   @default("MEDIUM") // HIGH, MEDIUM, LOW
  dueDate   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model NoteItem {
  id        String   @id @default(cuid())
  title     String
  content   String   // Supports Rich Formatting (H1, H2, H3, Indented Bullets, Tables)
  category  String   @default("GENERAL")
  pinned    Boolean  @default(false)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model FinanceIncome {
  id            String   @id @default(cuid())
  monthYear     String   @unique // YYYY-MM (e.g. 2026-07)
  monthlySalary Float    @default(7000000)
  bonusIncome   Float    @default(0)
  totalIncome   Float    @default(7000000)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model FinanceJar {
  id             String               @id @default(cuid())
  name           String               // e.g., "Tiết kiệm & Dự phòng", "Đầu tư Cổ phiếu", "Du lịch"
  categoryKey    String               // SAVINGS, STOCKS, BUSINESS, TRAVEL, FREE_SPEND
  percentage     Float                // e.g., 20.0
  icon           String               @default("PiggyBank")
  color          String               @default("#10b981")
  currentBalance Float                @default(0)
  createdAt      DateTime             @default(now())
  updatedAt      DateTime             @updatedAt
  transactions   FinanceTransaction[]
  notes          FinanceNote[]
}

model FinanceTransaction {
  id          String     @id @default(cuid())
  jarId       String
  jar         FinanceJar @relation(fields: [jarId], references: [id], onDelete: Cascade)
  type        String     // IN (Nạp tiền), OUT (Chi tiêu)
  amount      Float
  description String
  txDate      String     // YYYY-MM-DD
  createdAt   DateTime   @default(now())
}

model FinanceNote {
  id        String     @id @default(cuid())
  jarId     String
  jar       FinanceJar @relation(fields: [jarId], references: [id], onDelete: Cascade)
  content   String
  createdAt DateTime   @default(now())
  updatedAt DateTime   @updatedAt
}
